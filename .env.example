# ============================================
# OpsUp AI Document Editor - Environment Config
# ============================================
# Copy this file to .env and modify as needed

# --------------------------------------------
# OpenWebUI Configuration
# --------------------------------------------
OPENWEBUI_PORT=3000
WEBUI_SECRET_KEY=change-this-to-a-random-secret-key

# --------------------------------------------
# LLM Provider Configuration
# --------------------------------------------
# Option 1: OpenAI (recommended for production)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Option 2: Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Option 3: Local Ollama (uncomment to use)
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODELS=llama3

# --------------------------------------------
# SuperDoc Configuration
# --------------------------------------------
SUPERDOC_PORT=8081
# SUPERDOC_LICENSE_KEY=your-license-key-if-required

# --------------------------------------------
# MCP Server Configuration
# --------------------------------------------
MCP_PORT=8082

# --------------------------------------------
# RAG Configuration
# --------------------------------------------
CHROMA_PORT=8000
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=text-embedding-ada-002

# --------------------------------------------
# Ollama Local Configuration (optional)
# --------------------------------------------
OLLAMA_PORT=11434

# --------------------------------------------
# Production Settings
# --------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=.docx,.doc
