# OpsUp SuperDoc for OpenWebUI
# Copy to .env and adjust for your machine.

# Ports exposed on the host
OPENWEBUI_PORT=3000
SUPERDOC_PORT=8081
MCP_PORT=8082

# OpenWebUI
WEBUI_SECRET_KEY=change-this-to-a-random-secret-key
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE_URL=https://api.openai.com/v1
# Optional local Ollama endpoint used by OpenWebUI, not by SuperDoc
OLLAMA_BASE_URL=http://host.docker.internal:11434

# SuperDoc service
# Stores DOCX files and context-index.json in the Docker volume.
SUPERDOC_MAX_APPLY_ACTIONS=50
SUPERDOC_MAX_DOCUMENTS_PER_CHAT=100

# OpenWebUI Tool valves. If OpenWebUI is running inside this compose stack,
# SUPERDOC_API_URL is picked up by the tool as the internal URL.
SUPERDOC_API_INTERNAL_URL=http://host.docker.internal:8081
SUPERDOC_API_PUBLIC_URL=http://localhost:8081
SUPERDOC_REQUEST_TIMEOUT_SECONDS=120
SUPERDOC_ENABLE_ARTIFACT_EMBED=true
SUPERDOC_ARTIFACT_IFRAME_HEIGHT_PX=920
SUPERDOC_TOOL_STATE_FILE=/tmp/superdoc_tool_state.json
