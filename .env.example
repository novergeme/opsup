# ============================================
# OpsUp - Minimal runtime environment
# ============================================
# Copy to .env and set values for your machine.

# --------------------------------------------
# Core ports
# --------------------------------------------
OPENWEBUI_PORT=3000
SUPERDOC_PORT=8081
MCP_PORT=8082

# --------------------------------------------
# OpenWebUI
# --------------------------------------------
WEBUI_SECRET_KEY=change-this-to-a-random-secret-key
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE_URL=https://api.openai.com/v1
# Optional external Ollama endpoint
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --------------------------------------------
# SuperDoc backend
# --------------------------------------------
DEFAULT_MODEL=openai/gpt-oss-120b
DISABLE_INTERNAL_LLM_PROMPT_ROUTES=true

# --------------------------------------------
# OpenWebUI Tool (superdoc_tool.py) valves
# --------------------------------------------
SUPERDOC_API_INTERNAL_URL=http://host.docker.internal:8081
SUPERDOC_API_PUBLIC_URL=http://localhost:8081
SUPERDOC_REQUEST_TIMEOUT_SECONDS=120
SUPERDOC_ENABLE_ARTIFACT_EMBED=true
SUPERDOC_ARTIFACT_IFRAME_HEIGHT_PX=920
SUPERDOC_TOOL_STATE_FILE=/tmp/superdoc_tool_state.json
